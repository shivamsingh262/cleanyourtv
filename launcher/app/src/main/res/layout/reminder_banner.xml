<?xml version="1.0" encoding="utf-8"?>
<!-- Reminders: the banner shown over any app shortly before an agenda event. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="300dp"
    android:maxWidth="460dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/reminder_bg"
    android:paddingStart="18dp"
    android:paddingEnd="24dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:elevation="12dp">

    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_agenda"
        android:tint="#FFFFD54F"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/reminderWhen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#FFFFD54F"
            android:textSize="13sp"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/reminderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:fontFamily="@font/outfit_regular" />
    </LinearLayout>
</LinearLayout>
