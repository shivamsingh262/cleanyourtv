<?xml version="1.0" encoding="utf-8"?>
<!-- One photo print in the Photos screensaver: the whole photo on a white card, with a wider strip at the
     bottom for the date. PhotoDream sizes the photo to its own shape, so nothing is cropped.
     The outer frame is a clear margin the card and its shadow are drawn into as one hardware layer: tilted, the
     layer is filtered as a whole, so the card's edges come out smooth instead of stair-stepped. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="@dimen/print_shadow_room"
    android:clipToPadding="false"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/print_card"
        android:elevation="16dp"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/printPhoto"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/printDate"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center"
            android:textColor="#FF3A3330"
            android:textSize="20sp"
            android:fontFamily="@font/caveat"
            android:includeFontPadding="false" />
    </LinearLayout>
</FrameLayout>
